# Local mode uses real CPU sentence embeddings and returns verified excerpts.
PROVIDER=local
# Set PROVIDER=openai for LLM synthesis; never commit your actual key.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=data
START_URL=https://docs.python.org/3/tutorial/index.html
ALLOWED_PREFIX=https://docs.python.org/3/
MAX_PAGES=40
MAX_DEPTH=3
CRAWL_DELAY_S=0.5
CRAWL_CONCURRENCY=4
REQUEST_TIMEOUT_S=20
MAX_RESPONSE_BYTES=2000000
USER_AGENT=WebRAGAssessment/1.0 (+https://github.com/9059Rohith/WebRAG-Grounded-Website-Intelligence-Agent)
# 200 tokens fits the small local encoder; headings count toward this budget.
CHUNK_TOKENS=200
CHUNK_OVERLAP_TOKENS=30
MIN_CHUNK_TOKENS=20
RETRIEVE_K_DENSE=12
RETRIEVE_K_BM25=12
FINAL_TOP_K=8
# Development-calibrated OpenAI cosine gate; similarities vary by embedding model.
MIN_RELEVANCE=0.25
MMR_LAMBDA=0.7
RETRIEVAL_MODE=hybrid
DIVERSIFY=true
LLM_MAX_OUTPUT_TOKENS=900
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
VERIFY_WITH_LLM=true
MAX_QUESTION_CHARS=500
RATE_LIMIT_PER_MIN=30
CACHE_TTL_S=3600
CACHE_MAX_ITEMS=512
# Optional API auth. Blank values are treated as disabled.
API_TOKEN=
CORS_ORIGINS=[]
MAX_CONCURRENT_QUERIES=2
API_TIMEOUT_S=90
PORT=8000
